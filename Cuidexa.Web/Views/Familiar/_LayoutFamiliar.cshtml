@using Microsoft.AspNetCore.Antiforgery
@inject IConfiguration Configuracion
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cuidexa · Portal de familiares</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <meta name="vapid-public-key" content="@Configuracion["WebPush:PublicKey"]" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
</head>
<body>
    <nav class="navbar navbar-dark" style="background: linear-gradient(135deg, #06b6d4, #4f46e5);">
        <div class="container-fluid">
            <span class="navbar-brand"><i class="bi bi-people-fill me-1"></i> Cuidexa · Portal de familiares</span>
            <div class="d-flex gap-2">
                <button id="botonNotificaciones" type="button" class="btn btn-outline-light btn-sm" data-endpoint-suscribir="/Familiar/SuscribirPush" hidden>
                    <i class="bi bi-bell"></i> Activar notificaciones
                </button>
                <a href="/Familiar/Logout" class="btn btn-outline-light btn-sm">Salir</a>
            </div>
        </div>
    </nav>
    <div class="container-fluid pt-3 pt-md-4 pb-5" style="max-width: 760px;">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @RenderBody()
    </div>
    <script src="~/js/push.js" asp-append-version="true"></script>
</body>
</html>
