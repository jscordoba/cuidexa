@using Cuidexa.Web.Models.Enums
@{
    Layout = "_LayoutFamiliar";
    var residente = (Residente)ViewBag.Residente;
    var documentos = (List<DocumentoFirmado>)ViewBag.Documentos;
    var incidencias = (List<Incidencia>)ViewBag.Incidencias;

    string EtiquetaCategoria(CategoriaDocumentoFirmado c) => c switch
    {
        CategoriaDocumentoFirmado.ConsentimientoInformado => "Consentimiento informado",
        CategoriaDocumentoFirmado.Admision => "Admisión",
        CategoriaDocumentoFirmado.ConformidadIncidencia => "Conformidad de incidencia",
        CategoriaDocumentoFirmado.Entrega => "Entrega",
        _ => "Otro"
    };

    string EtiquetaTipo(TipoIncidencia t) => t switch
    {
        TipoIncidencia.Residente => "Residente",
        TipoIncidencia.Personal => "Personal/operativa",
        TipoIncidencia.Instalaciones => "Instalaciones/seguridad",
        _ => t.ToString()
    };
}
<h4 class="mb-1">@residente.Nombre @residente.Apellidos</h4>
<p class="text-muted small mb-4">Solo se muestran documentos firmados e incidencias ya resueltas — para cualquier otra consulta, contacta directamente con el centro.</p>

<h6 class="text-muted">Documentos firmados</h6>
@if (!documentos.Any())
{
    <p class="text-muted small mb-4">Sin documentos firmados todavía.</p>
}
else
{
    <div class="mb-4">
        @foreach (var d in documentos)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <span class="badge rounded-pill text-bg-light border mb-2"><i class="bi bi-tag me-1"></i>@EtiquetaCategoria(d.Categoria)</span>
                    <h6 class="mb-1">@d.Titulo</h6>
                    <p class="mb-2">@d.Descripcion</p>
                    <img src="@d.FirmaImagenBase64" alt="Firma de @d.FirmanteNombre" style="max-width:220px; max-height:80px;" class="border rounded bg-white mb-2 d-block" />
                    <small class="text-muted">
                        Firmado por @d.FirmanteNombre @(string.IsNullOrWhiteSpace(d.FirmanteRelacion) ? "" : $"({d.FirmanteRelacion})") ·
                        @d.FechaFirma.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            </div>
        }
    </div>
}

<h6 class="text-muted">Incidencias resueltas</h6>
@if (!incidencias.Any())
{
    <p class="text-muted small mb-0">Sin incidencias resueltas todavía.</p>
}
else
{
    @foreach (var i in incidencias)
    {
        <div class="card mb-2">
            <div class="card-body">
                <span class="badge rounded-pill text-bg-light border mb-2"><i class="bi bi-tag me-1"></i>@EtiquetaTipo(i.Tipo)</span>
                <h6 class="mb-1">@i.Titulo</h6>
                <p class="mb-1">@i.Descripcion</p>
                @if (!string.IsNullOrWhiteSpace(i.NotasResolucion))
                {
                    <p class="mb-1 small"><strong>Resolución:</strong> @i.NotasResolucion</p>
                }
                <small class="text-muted">Resuelta el @i.FechaResolucion?.ToString("dd/MM/yyyy")</small>
            </div>
        </div>
    }
}
