@{
    Layout = null;
    var cuentasDemo = new[] { "admin", "cocina", "auxiliar", "direccion", "enfermeria", "profesional", "limpieza" };
    // Marca genérica siempre: todavía no se sabe a qué organización pertenece
    // quien está entrando (eso depende justo del código de centro que está a
    // punto de escribir), así que no hay forma de resolver una marca real
    // aquí sin un lookup dinámico — decisión explícita del plan de Fase 9.
    const string nombreCentro = "Cuidexa";
    var culturaActual = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@culturaActual">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@nombreCentro · @Localizer["Acceso"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .pantalla-acceso {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, #eef2ff 0%, #f8f9fa 40%);
            padding: 1.75rem 1rem;
        }
        .tarjeta-acceso {
            width: 100%;
            max-width: 380px;
        }
        .logo-cuidexa {
            width: 4.25rem;
            height: 4.25rem;
            border-radius: 50%;
            background: linear-gradient(135deg, #06b6d4, #4f46e5);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 2rem;
            margin: 0 auto 1rem;
            box-shadow: 0 10px 24px rgba(79, 70, 229, .28);
        }
        .form-acceso .input-group-text {
            background: #fff;
            border-right: none;
            color: #6c757d;
        }
        .form-acceso .form-control {
            border-left: none;
        }
        .form-acceso .form-control:focus {
            box-shadow: none;
            border-color: #ced4da;
        }
        .form-acceso .input-group:focus-within {
            box-shadow: 0 0 0 .25rem rgba(79, 70, 229, .15);
            border-radius: .5rem;
        }
        .btn-acceso {
            background: var(--enlace-color);
            border: none;
            color: #fff;
        }
        .btn-acceso:hover {
            background: var(--enlace-color-hover);
            color: #fff;
        }
        .chip-cuenta-demo {
            font-size: .72rem;
            background: #fff;
        }
    </style>
</head>
<body>
    <div class="pantalla-acceso">
        <div class="tarjeta-acceso">
            <div class="text-center mb-4">
                <div class="logo-cuidexa"><i class="bi bi-heart-fill"></i></div>
                <h1 class="h4 mb-1 fw-bold" style="color:var(--navy)">@nombreCentro</h1>
                <p class="text-muted small mb-2">@Localizer["Mejores cuidados, una vida más plena"]</p>
                <div class="d-flex justify-content-center gap-1">
                    <form method="post" action="/Cultura/Cambiar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cultura" value="es" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="btn btn-sm @(culturaActual == "es" ? "btn-secondary" : "btn-outline-secondary")" @(culturaActual == "es" ? "disabled" : "")>ES</button>
                    </form>
                    <form method="post" action="/Cultura/Cambiar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cultura" value="en" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="btn btn-sm @(culturaActual == "en" ? "btn-secondary" : "btn-outline-secondary")" @(culturaActual == "en" ? "disabled" : "")>EN</button>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@e.ErrorMessage</div>
                        }
                    </div>
                }
                <form method="post" class="form-acceso">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small text-muted">@Localizer["Código de centro"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-building"></i></span>
                            <input name="codigoCentro" class="form-control text-uppercase" required autofocus autocomplete="off" value="DEMO" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">@Localizer["Email"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="email" class="form-control" required autocomplete="username" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">@Localizer["Contraseña"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" name="password" class="form-control" required autocomplete="current-password" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-acceso w-100 py-2 fw-semibold">@Localizer["Entrar"]</button>
                </form>
            </div>

            <div class="mt-3 text-center">
                <p class="text-muted small mb-2">Cuentas de demostración · contraseña <strong>Demo1234!</strong> para todas</p>
                <div class="d-flex flex-wrap justify-content-center gap-1">
                    @foreach (var cuenta in cuentasDemo)
                    {
                        <span class="badge rounded-pill border text-muted fw-normal chip-cuenta-demo">@(cuenta + "@demo.local")</span>
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>
