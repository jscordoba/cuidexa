@model Centro
<a href="/Admin" class="d-inline-block mb-2 text-decoration-none">&larr; @Localizer["Volver al panel"]</a>
<h4 class="mb-1">@Localizer["Datos del centro"]</h4>
<p class="text-muted small mb-3">@Localizer["Código de centro (login):"] <code>@Model.Codigo</code></p>
<p class="text-muted small">
    @Localizer["Estos datos son propios de este centro físico. El nombre de marca, el logo y el color de acento se comparten con el resto de centros de tu organización y se gestionan aparte"]
    @if (User.IsInRole("DirectorOrganizacion"))
    {
        <a href="/Organizacion/Marca">@Localizer["en Marca de organización"]</a>
    }
    else
    {
        <text>@Localizer["en \"Marca de organización\" (solo Director de Organización)."]</text>
    }
</p>

<div class="card p-3 p-md-4" style="max-width: 560px;">
    <form method="post" action="/Admin/ActualizarCentro" class="mb-0">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">@Localizer["Nombre del centro"]</label>
            <input name="nombre" class="form-control" value="@Model.Nombre" required />
            <div class="form-text">@Localizer["El nombre de este edificio/sede (ej. \"Centro Tres Cantos\") — distinto del nombre de marca."]</div>
        </div>
        <div class="mb-3">
            <label class="form-label">@Localizer["Dirección"]</label>
            <input name="direccion" class="form-control" value="@Model.Direccion" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Localizer["Teléfono"]</label>
            <input name="telefono" class="form-control" value="@Model.Telefono" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Localizer["Email"]</label>
            <input type="email" name="email" class="form-control" value="@Model.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Localizer["Responsable — nombre"]</label>
            <input name="responsableNombre" class="form-control" value="@Model.ResponsableNombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Localizer["Responsable — cargo"]</label>
            <input name="responsableCargo" class="form-control" value="@Model.ResponsableCargo" placeholder="@Localizer["Ej. Directora del centro"]" />
        </div>
        <button class="btn btn-primary">@Localizer["Guardar datos"]</button>
    </form>
</div>
