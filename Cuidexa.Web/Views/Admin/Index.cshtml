@using Cuidexa.Web.Models
@using Cuidexa.Web.Models.Enums
@{
    var actividad = (List<AuditLog>)ViewBag.ActividadReciente;
    var distribucion = (Dictionary<Movilidad, int>)ViewBag.Distribucion;
    var totalDistribucion = distribucion.Values.Sum();

    var coloresMovilidad = new Dictionary<Movilidad, string>
    {
        { Movilidad.Autonomo, "#22c55e" },
        { Movilidad.SillaRuedas, "#3b82f6" },
        { Movilidad.AsistenciaTotal, "#f43f5e" }
    };
    var etiquetasMovilidad = new Dictionary<Movilidad, string>
    {
        { Movilidad.Autonomo, Localizer["Autónomo"] },
        { Movilidad.SillaRuedas, Localizer["Silla de ruedas"] },
        { Movilidad.AsistenciaTotal, Localizer["Asistencia total"] }
    };

    // Donut sin librerías: un conic-gradient con un tramo de color por cada
    // nivel de movilidad presente, proporcional a cuántos residentes lo tienen.
    string gradiente = "#e9ecef";
    if (totalDistribucion > 0)
    {
        var partes = new List<string>();
        double acumulado = 0;
        foreach (var mov in Enum.GetValues<Movilidad>())
        {
            var cantidad = distribucion.GetValueOrDefault(mov);
            if (cantidad == 0) { continue; }
            var inicio = (acumulado / totalDistribucion * 360).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            acumulado += cantidad;
            var fin = (acumulado / totalDistribucion * 360).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            partes.Add($"{coloresMovilidad[mov]} {inicio}deg {fin}deg");
        }
        gradiente = string.Join(", ", partes);
    }

    var avisosPendientes = (int)ViewBag.AvisosPendientes;
    var claseUrgenciaAvisos = avisosPendientes == 0 ? "urgencia-ok" : avisosPendientes <= 2 ? "urgencia-media" : "urgencia-alta";
}
@await Html.PartialAsync("_Saludo")

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100 tarjeta-dashboard">
            <div class="icono-dashboard i-azul"><i class="bi bi-people-fill"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Residentes"]</h6>
                <h2 class="mb-0">@ViewBag.TotalResidentes</h2>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 tarjeta-dashboard">
            <div class="icono-dashboard i-verde"><i class="bi bi-person-badge"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Personal activo"]</h6>
                <h2 class="mb-0">@ViewBag.TotalPersonal</h2>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 tarjeta-dashboard">
            <div class="icono-dashboard i-morado"><i class="bi bi-calendar3"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Turnos hoy"]</h6>
                <h2 class="mb-0">@ViewBag.TurnosHoy</h2>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Admin/Avisos" class="card h-100 text-decoration-none text-body tarjeta-dashboard @claseUrgenciaAvisos">
            <div class="icono-dashboard i-rosa"><i class="bi bi-bell-fill"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Avisos pendientes"]</h6>
                <h2 class="mb-0">@avisosPendientes</h2>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-2">@Localizer["Accesos rápidos"]</h6>
                <a href="/Residentes" class="fila-acceso">
                    <div class="icono-dashboard i-azul"><i class="bi bi-people-fill"></i></div>
                    <span>@Localizer["Gestión de residentes"]</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a href="/Empleados" class="fila-acceso">
                    <div class="icono-dashboard i-verde"><i class="bi bi-person-badge"></i></div>
                    <span>@Localizer["Usuarios y personal"]</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a href="/Turnos" class="fila-acceso">
                    <div class="icono-dashboard i-morado"><i class="bi bi-calendar3"></i></div>
                    <span>@Localizer["Turnos"]</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a href="/Turnos/Cambios" class="fila-acceso">
                    <div class="icono-dashboard i-rosa"><i class="bi bi-arrow-left-right"></i></div>
                    <span>@Localizer["Cambios de turno pendientes"] <span class="badge bg-secondary rounded-pill">@ViewBag.CambiosPendientes</span></span>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-2">@Localizer["Actividad reciente"]</h6>
                @if (!actividad.Any())
                {
                    <p class="text-muted small mb-0">@Localizer["Sin actividad registrada todavía."]</p>
                }
                else
                {
                    @foreach (var a in actividad)
                    {
                        <div class="fila-actividad">
                            <div class="icono-actividad"><i class="bi bi-clock-history"></i></div>
                            <div>
                                <div class="small">@a.Detalle</div>
                                <div class="text-muted" style="font-size:.75rem">@(a.Empleado?.Nombre ?? Localizer["Sistema"]) · @a.FechaHora.ToString("dd/MM HH:mm")</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-2">@Localizer["Distribución de residentes"]</h6>
                @if (totalDistribucion == 0)
                {
                    <p class="text-muted small mb-0">@Localizer["Todavía no hay residentes activos."]</p>
                }
                else
                {
                    <div class="d-flex justify-content-center mb-3">
                        <div class="donut" style="background: conic-gradient(@Html.Raw(gradiente));"></div>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var mov in Enum.GetValues<Movilidad>())
                        {
                            var cantidad = distribucion.GetValueOrDefault(mov);
                            if (cantidad == 0) { continue; }
                            <div class="leyenda-donut">
                                <span class="punto" style="background:@coloresMovilidad[mov]"></span>
                                <span>@etiquetasMovilidad[mov]</span>
                                <span class="text-muted ms-auto">@cantidad</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
