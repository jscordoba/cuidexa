@using Cuidexa.Web.Models.Enums
@using Cuidexa.Web.ViewHelpers
@using Cuidexa.Web.Services
@using Microsoft.AspNetCore.Antiforgery
@inject IConfiguration Configuracion
@inject IOrganizacionService OrganizacionService
@inject IAntiforgery Antiforgery
@functions {
    // Un único lugar para la navegación de cada rol — se usa tanto en la
    // barra lateral (escritorio) como en la barra inferior (móvil), así las
    // dos nunca se desincronizan entre sí.
    List<(string Icono, string Etiqueta, string Href)> ObtenerNavItems()
    {
        if (User.IsInRole("Admin"))
        {
            return new()
            {
                ("bi-bell-fill", "Avisos", "/Admin/Avisos"),
                ("bi-exclamation-octagon-fill", "Incidencias", "/Admin/Incidencias"),
                ("bi-people-fill", "Residentes", "/Residentes"),
                ("bi-person-badge", "Usuarios", "/Empleados"),
                ("bi-calendar3", "Turnos", "/Turnos"),
                ("bi-tablet", "Dispositivos", "/Dispositivos"),
                ("bi-diagram-3-fill", "Grupos", "/Grupos"),
                ("bi-file-earmark-bar-graph-fill", "Informes", "/Informes"),
                ("bi-building-gear", "Centro", "/Admin/Centro"),
            };
        }
        if (User.IsInRole("Cocina"))
        {
            return new()
            {
                ("bi-bell-fill", "Avisos", "/Cocina/Avisos"),
                ("bi-exclamation-octagon-fill", "Incidencias", "/Cocina/Incidencias"),
                ("bi-cup-hot-fill", "Comensales", "/Cocina/Comensales"),
                ("bi-calendar3", "Turnos", "/Cocina/Turnos"),
            };
        }
        if (User.IsInRole("Auxiliar"))
        {
            return new()
            {
                ("bi-bell-fill", "Avisos", "/Auxiliares/Avisos"),
                ("bi-exclamation-octagon-fill", "Incidencias", "/Auxiliares/Incidencias"),
                ("bi-calendar3", "Turnos", "/Auxiliares/Turnos"),
            };
        }
        if (User.IsInRole("Enfermeria"))
        {
            return new()
            {
                ("bi-bell-fill", "Avisos", "/Enfermeria/Avisos"),
                ("bi-exclamation-octagon-fill", "Incidencias", "/Enfermeria/Incidencias"),
                ("bi-capsule", "Agenda", "/Enfermeria/Agenda"),
                ("bi-people-fill", "Residentes", "/Enfermeria/Residentes"),
                ("bi-calendar3", "Turnos", "/Enfermeria/Turnos"),
            };
        }
        if (User.IsInRole("Profesional"))
        {
            return new()
            {
                ("bi-bell-fill", "Avisos", "/Profesionales/Avisos"),
                ("bi-exclamation-octagon-fill", "Incidencias", "/Profesionales/Incidencias"),
                ("bi-calendar2-week", "Agenda", "/Profesionales/Agenda"),
                ("bi-people-fill", "Residentes", "/Profesionales/Residentes"),
                ("bi-calendar3", "Turnos", "/Profesionales/Turnos"),
            };
        }
        if (User.IsInRole("Limpieza"))
        {
            return new()
            {
                ("bi-bell-fill", "Avisos", "/Limpieza/Avisos"),
                ("bi-exclamation-octagon-fill", "Incidencias", "/Limpieza/Incidencias"),
                ("bi-clipboard-check", "Tareas", "/Limpieza/Tareas"),
                ("bi-calendar3", "Turnos", "/Limpieza/Turnos"),
            };
        }
        if (User.IsInRole("DirectorOrganizacion"))
        {
            return new()
            {
                ("bi-people-fill", "Residentes", "/Residentes"),
                ("bi-person-badge", "Usuarios", "/Empleados"),
                ("bi-calendar3", "Turnos", "/Turnos"),
                ("bi-tablet", "Dispositivos", "/Dispositivos"),
                ("bi-diagram-3-fill", "Grupos", "/Grupos"),
                ("bi-file-earmark-bar-graph-fill", "Informes", "/Informes"),
                ("bi-building-gear", "Marca", "/Organizacion/Marca"),
            };
        }
        return new();
    }

    bool EsActivo(string href) =>
        string.Equals(Context.Request.Path.Value?.TrimEnd('/'), href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
}
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var navItems = autenticado ? ObtenerNavItems() : new();
    var rolTexto = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    Enum.TryParse<RolEmpleado>(rolTexto, out var rolActual);
    var (iconoRol, claseColorRol, etiquetaRol) = RolPresentacion.Obtener(rolActual);
    // Solo hay Organizacion resuelta con sesión ya iniciada (ver ITenantContext)
    // — _Layout.cshtml nunca se renderiza sin sesión (las pantallas de login
    // usan Layout = null), así que esto es siempre seguro de llamar aquí.
    var organizacion = autenticado ? await OrganizacionService.ObtenerAsync() : null;
    var nombreCentro = string.IsNullOrWhiteSpace(organizacion?.Nombre) ? "Cuidexa" : organizacion.Nombre;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@nombreCentro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(organizacion?.ColorAcento))
    {
        <style>:root { --enlace-color: @organizacion.ColorAcento; --enlace-color-hover: @ColorHelper.Oscurecer(organizacion.ColorAcento); }</style>
    }
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#101a30" />
    <link rel="apple-touch-icon" href="~/icons/icon.svg" />
    <link rel="icon" href="~/icons/icon.svg" />
    <meta name="vapid-public-key" content="@Configuracion["WebPush:PublicKey"]" />
    @if (autenticado)
    {
        <!-- Token CSRF para el único POST por fetch() de la app (wwwroot/js/push.js)
             — el resto de formularios llevan su propio @@Html.AntiForgeryToken(). -->
        <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
</head>
<body>
    @if (autenticado)
    {
        <!-- Barra superior: SOLO en móvil (marca + cuenta). En escritorio la
             marca, la navegación y la cuenta viven todas en la barra lateral
             de abajo — un único "menú" por dispositivo, no dos compitiendo. -->
        <nav class="navbar navbar-dark bg-dark d-md-none">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">@nombreCentro</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <div class="d-flex flex-column mt-2">
                        <span class="text-light mb-2">@User.Identity!.Name (@etiquetaRol)</span>
                        <a class="btn btn-outline-light btn-sm" href="/Account/Logout">Salir</a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Barra lateral: SOLO en escritorio (≥768px) — la misma lista de
             navegación que la barra inferior móvil, solo que presentada a lo
             largo en vez de abajo, para que el "shell" de la app se sienta
             igual en ambos tamaños. -->
        <nav class="sidebar-escritorio d-none d-md-flex flex-column">
            <a href="/" class="marca-sidebar">
                @if (!string.IsNullOrWhiteSpace(organizacion?.LogoRuta))
                {
                    <div class="logo-cuidexa-mini logo-cuidexa-imagen"><img src="@organizacion.LogoRuta" alt="@nombreCentro" /></div>
                }
                else
                {
                    <div class="logo-cuidexa-mini"><i class="bi bi-heart-fill"></i></div>
                }
                <div>
                    <div class="fw-bold">@nombreCentro</div>
                    <div class="text-muted" style="font-size:.68rem">Mejores cuidados</div>
                </div>
            </a>

            @if (navItems.Any())
            {
                <div class="nav-sidebar">
                    @foreach (var item in navItems)
                    {
                        <a href="@item.Href" class="@(EsActivo(item.Href) ? "activo" : "")">
                            <i class="bi @item.Icono"></i>
                            <span>@item.Etiqueta</span>
                        </a>
                    }
                </div>
            }

            <div class="flex-grow-1"></div>

            <a href="/Account/Logout" class="cuenta-sidebar">
                <div class="avatar-rol pequeno @claseColorRol"><i class="bi @iconoRol"></i></div>
                <div class="flex-grow-1">
                    <div class="nombre">@User.Identity!.Name</div>
                    <div class="rol">@etiquetaRol</div>
                </div>
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </nav>
    }

    <div class="container-fluid pt-3 pt-md-4 pb-5 @(autenticado ? "con-sidebar" : "") @(navItems.Any() ? "pb-nav-movil" : "")">
        @if (autenticado)
        {
            <button id="botonNotificaciones" type="button" class="toggle-colapsable mb-3" hidden>
                <i class="bi bi-bell"></i> Activar notificaciones
            </button>
        }
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @RenderBody()
    </div>

    @if (navItems.Any())
    {
        <nav class="nav-inferior-movil d-md-none">
            @foreach (var item in navItems)
            {
                <a href="@item.Href" class="@(EsActivo(item.Href) ? "activo" : "")">
                    <i class="bi @item.Icono"></i>
                    <span>@item.Etiqueta</span>
                </a>
            }
        </nav>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/filtro.js" asp-append-version="true"></script>
    <script src="~/js/filas-clicables.js" asp-append-version="true"></script>
    @if (autenticado)
    {
        <script src="~/js/push.js" asp-append-version="true"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
