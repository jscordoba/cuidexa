@model IncidenciasViewModel
@using Cuidexa.Web.Models.Enums
@{
    var abiertas = Model.Incidencias.Where(i => i.Estado != EstadoIncidencia.Resuelta)
        .OrderByDescending(i => i.Gravedad == GravedadIncidencia.Urgente)
        .ThenByDescending(i => i.FechaCreacion).ToList();
    // Informativas se crean directamente Resueltas (ver IncidenciaService) —
    // se separan de las que de verdad pasaron por el flujo de resolución,
    // para no dar a entender que alguien "resolvió" algo que solo era una nota.
    var informativas = Model.Incidencias.Where(i => i.Caracter == CaracterIncidencia.Informativa)
        .OrderByDescending(i => i.FechaCreacion).ToList();
    var resueltas = Model.Incidencias.Where(i => i.Estado == EstadoIncidencia.Resuelta && i.Caracter == CaracterIncidencia.RequiereSeguimiento)
        .OrderByDescending(i => i.FechaResolucion).ToList();

    string ClaseGravedad(GravedadIncidencia g) => g switch
    {
        GravedadIncidencia.Urgente => "border-danger",
        GravedadIncidencia.Alta => "border-warning",
        _ => ""
    };

    string EtiquetaTipo(TipoIncidencia t) => t switch
    {
        TipoIncidencia.Residente => Localizer["Residente"],
        TipoIncidencia.Personal => Localizer["Personal/operativa"],
        TipoIncidencia.Instalaciones => Localizer["Instalaciones/seguridad"],
        _ => t.ToString()
    };

    string EtiquetaEstado(EstadoIncidencia e) => e switch
    {
        EstadoIncidencia.Abierta => Localizer["Abierta"],
        EstadoIncidencia.EnProgreso => Localizer["En progreso"],
        EstadoIncidencia.Resuelta => Localizer["Resuelta"],
        _ => e.ToString()
    };
}
<a href="/@Model.RutaBase" class="d-inline-block mb-2 text-decoration-none">&larr; @Localizer["Volver al panel"]</a>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-exclamation-octagon-fill me-2 text-muted"></i>@Localizer["Incidencias"]</h4>
    <div class="d-flex gap-2">
        @if (Model.PuedeFirmar)
        {
            <a href="/@Model.RutaBase/DocumentosFirmados" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pen me-1"></i>@Localizer["Documentos firmados"]</a>
        }
        @if (Model.PuedeCrear)
        {
            <a href="/@Model.RutaBase/CrearIncidencia" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>@Localizer["Reportar incidencia"]</a>
        }
    </div>
</div>

@if (!Model.Incidencias.Any())
{
    <p class="text-muted">@Localizer["No hay incidencias registradas."]</p>
}
else
{
    <input type="search" id="filtroIncidencias" class="form-control mb-2" placeholder="@Localizer["Buscar en las incidencias..."]" />
    <div id="listaIncidencias">
        @if (!abiertas.Any())
        {
            <p class="text-muted small">@Localizer["Sin incidencias abiertas — al día."]</p>
        }
        @foreach (var i in abiertas)
        {
            <div class="card mb-2 @ClaseGravedad(i.Gravedad)">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge rounded-pill text-bg-light border"><i class="bi bi-tag me-1"></i>@EtiquetaTipo(i.Tipo)</span>
                        <span class="badge rounded-pill text-bg-light border">@EtiquetaEstado(i.Estado)</span>
                        @if (i.Gravedad == GravedadIncidencia.Urgente)
                        {
                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>@Localizer["Urgente"]</span>
                        }
                        else if (i.Gravedad == GravedadIncidencia.Alta)
                        {
                            <span class="badge bg-warning text-dark">@Localizer["Alta"]</span>
                        }
                    </div>
                    <h6 class="mb-1">@i.Titulo</h6>
                    @if (i.Residente is not null)
                    {
                        <p class="mb-1 small text-muted"><i class="bi bi-person me-1"></i>@i.Residente.Nombre @i.Residente.Apellidos</p>
                    }
                    <p class="mb-1">@i.Descripcion</p>
                    <small class="text-muted">
                        @Localizer["Reportada por"] @(i.EmpleadoOrigen?.Nombre ?? i.RolOrigen.ToString()) · @i.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                    </small>
                    @if (i.DocumentosFirmados.Any() || Model.PuedeFirmar)
                    {
                        <div class="mt-1">
                            @if (i.DocumentosFirmados.Any())
                            {
                                <span class="badge rounded-pill text-bg-light border"><i class="bi bi-pen me-1"></i>@i.DocumentosFirmados.Count @Localizer["firma(s)"]</span>
                            }
                            @if (Model.PuedeFirmar)
                            {
                                <a href="/@Model.RutaBase/FirmarIncidencia?incidenciaId=@i.Id" class="small ms-1">@Localizer["Firmar conformidad"]</a>
                            }
                        </div>
                    }

                    <form method="post" action="/@Model.RutaBase/ResolverIncidencia" class="mt-2 row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@i.Id" />
                        <div class="col-auto">
                            <select name="estado" class="form-select form-select-sm">
                                @if (i.Estado == EstadoIncidencia.Abierta)
                                {
                                    <option value="@EstadoIncidencia.EnProgreso">@Localizer["Marcar en progreso"]</option>
                                }
                                <option value="@EstadoIncidencia.Resuelta">@Localizer["Marcar resuelta"]</option>
                            </select>
                        </div>
                        <div class="col-auto flex-grow-1" style="min-width:180px;">
                            <input name="notasResolucion" class="form-control form-control-sm" placeholder="@Localizer["Notas (obligatorio al resolver)"]" />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-secondary">@Localizer["Actualizar"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (informativas.Any())
        {
            <button class="toggle-colapsable mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#incidenciasInformativas" aria-expanded="false" aria-controls="incidenciasInformativas">
                @Localizer["Ver"] @informativas.Count @Localizer["informativa(s)"] <span class="caret">&#9662;</span>
            </button>
            <div class="collapse" id="incidenciasInformativas">
                @foreach (var i in informativas)
                {
                    <div class="card mb-2">
                        <div class="card-body">
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge rounded-pill text-bg-light border"><i class="bi bi-tag me-1"></i>@EtiquetaTipo(i.Tipo)</span>
                                <span class="badge rounded-pill text-bg-light border"><i class="bi bi-info-circle me-1"></i>@Localizer["Informativa"]</span>
                            </div>
                            <h6 class="mb-1">@i.Titulo</h6>
                            @if (i.Residente is not null)
                            {
                                <p class="mb-1 small text-muted"><i class="bi bi-person me-1"></i>@i.Residente.Nombre @i.Residente.Apellidos</p>
                            }
                            <p class="mb-1">@i.Descripcion</p>
                            <small class="text-muted">
                                @Localizer["Reportada por"] @(i.EmpleadoOrigen?.Nombre ?? i.RolOrigen.ToString()) · @i.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </small>
                            @if (i.DocumentosFirmados.Any() || Model.PuedeFirmar)
                            {
                                <div class="mt-1">
                                    @if (i.DocumentosFirmados.Any())
                                    {
                                        <span class="badge rounded-pill text-bg-light border"><i class="bi bi-pen me-1"></i>@i.DocumentosFirmados.Count @Localizer["firma(s)"]</span>
                                    }
                                    @if (Model.PuedeFirmar)
                                    {
                                        <a href="/@Model.RutaBase/FirmarIncidencia?incidenciaId=@i.Id" class="small ms-1">@Localizer["Firmar conformidad"]</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (resueltas.Any())
        {
            <button class="toggle-colapsable mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#incidenciasResueltas" aria-expanded="false" aria-controls="incidenciasResueltas">
                @Localizer["Ver"] @resueltas.Count @Localizer["resuelta(s)"] <span class="caret">&#9662;</span>
            </button>
            <div class="collapse" id="incidenciasResueltas">
                @foreach (var i in resueltas)
                {
                    <div class="card mb-2">
                        <div class="card-body">
                            <span class="badge rounded-pill text-bg-light border mb-2"><i class="bi bi-tag me-1"></i>@EtiquetaTipo(i.Tipo)</span>
                            <h6 class="mb-1">@i.Titulo</h6>
                            <p class="mb-1">@i.Descripcion</p>
                            @if (!string.IsNullOrWhiteSpace(i.NotasResolucion))
                            {
                                <p class="mb-1 small"><strong>@Localizer["Resolución:"]</strong> @i.NotasResolucion</p>
                            }
                            <small class="text-muted">
                                @Localizer["Resuelta por"] @(i.ResueltoPor?.Nombre ?? "-") · @i.FechaResolucion?.ToString("dd/MM/yyyy HH:mm")
                            </small>
                            @if (i.DocumentosFirmados.Any() || Model.PuedeFirmar)
                            {
                                <div class="mt-1">
                                    @if (i.DocumentosFirmados.Any())
                                    {
                                        <span class="badge rounded-pill text-bg-light border"><i class="bi bi-pen me-1"></i>@i.DocumentosFirmados.Count @Localizer["firma(s)"]</span>
                                    }
                                    @if (Model.PuedeFirmar)
                                    {
                                        <a href="/@Model.RutaBase/FirmarIncidencia?incidenciaId=@i.Id" class="small ms-1">@Localizer["Firmar conformidad"]</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <p id="incidenciasSinResultados" class="text-muted" hidden>@Localizer["Ninguna incidencia coincide con la búsqueda."]</p>
}

@section Scripts {
    <script>activarFiltro('#filtroIncidencias', '#listaIncidencias .card', { vacio: '#incidenciasSinResultados' });</script>
}
