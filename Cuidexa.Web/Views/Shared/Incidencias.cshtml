@model IncidenciasViewModel
@using Cuidexa.Web.Models.Enums
@{
    var abiertas = Model.Incidencias.Where(i => i.Estado != EstadoIncidencia.Resuelta)
        .OrderByDescending(i => i.Gravedad == GravedadIncidencia.Urgente)
        .ThenByDescending(i => i.FechaCreacion).ToList();
    var resueltas = Model.Incidencias.Where(i => i.Estado == EstadoIncidencia.Resuelta)
        .OrderByDescending(i => i.FechaResolucion).ToList();

    string ClaseGravedad(GravedadIncidencia g) => g switch
    {
        GravedadIncidencia.Urgente => "border-danger",
        GravedadIncidencia.Alta => "border-warning",
        _ => ""
    };

    string EtiquetaTipo(TipoIncidencia t) => t switch
    {
        TipoIncidencia.Residente => "Residente",
        TipoIncidencia.Personal => "Personal/operativa",
        TipoIncidencia.Instalaciones => "Instalaciones/seguridad",
        _ => t.ToString()
    };
}
<a href="/@Model.RutaBase" class="d-inline-block mb-2 text-decoration-none">&larr; Volver al panel</a>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-exclamation-octagon-fill me-2 text-muted"></i>Incidencias</h4>
    @if (Model.PuedeCrear)
    {
        <a href="/@Model.RutaBase/CrearIncidencia" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Reportar incidencia</a>
    }
</div>

@if (!Model.Incidencias.Any())
{
    <p class="text-muted">No hay incidencias registradas.</p>
}
else
{
    <input type="search" id="filtroIncidencias" class="form-control mb-2" placeholder="Buscar en las incidencias..." />
    <div id="listaIncidencias">
        @if (!abiertas.Any())
        {
            <p class="text-muted small">Sin incidencias abiertas — al día.</p>
        }
        @foreach (var i in abiertas)
        {
            <div class="card mb-2 @ClaseGravedad(i.Gravedad)">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge rounded-pill text-bg-light border"><i class="bi bi-tag me-1"></i>@EtiquetaTipo(i.Tipo)</span>
                        <span class="badge rounded-pill text-bg-light border">@i.Estado</span>
                        @if (i.Gravedad == GravedadIncidencia.Urgente)
                        {
                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Urgente</span>
                        }
                        else if (i.Gravedad == GravedadIncidencia.Alta)
                        {
                            <span class="badge bg-warning text-dark">Alta</span>
                        }
                    </div>
                    <h6 class="mb-1">@i.Titulo</h6>
                    @if (i.Residente is not null)
                    {
                        <p class="mb-1 small text-muted"><i class="bi bi-person me-1"></i>@i.Residente.Nombre @i.Residente.Apellidos</p>
                    }
                    <p class="mb-1">@i.Descripcion</p>
                    <small class="text-muted">
                        Reportada por @(i.EmpleadoOrigen?.Nombre ?? i.RolOrigen.ToString()) · @i.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                    </small>

                    <form method="post" action="/@Model.RutaBase/ResolverIncidencia" class="mt-2 row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@i.Id" />
                        <div class="col-auto">
                            <select name="estado" class="form-select form-select-sm">
                                @if (i.Estado == EstadoIncidencia.Abierta)
                                {
                                    <option value="@EstadoIncidencia.EnProgreso">Marcar en progreso</option>
                                }
                                <option value="@EstadoIncidencia.Resuelta">Marcar resuelta</option>
                            </select>
                        </div>
                        <div class="col-auto flex-grow-1" style="min-width:180px;">
                            <input name="notasResolucion" class="form-control form-control-sm" placeholder="Notas (obligatorio al resolver)" />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-secondary">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (resueltas.Any())
        {
            <button class="toggle-colapsable mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#incidenciasResueltas" aria-expanded="false" aria-controls="incidenciasResueltas">
                Ver @resueltas.Count resuelta(s) <span class="caret">&#9662;</span>
            </button>
            <div class="collapse" id="incidenciasResueltas">
                @foreach (var i in resueltas)
                {
                    <div class="card mb-2">
                        <div class="card-body">
                            <span class="badge rounded-pill text-bg-light border mb-2"><i class="bi bi-tag me-1"></i>@EtiquetaTipo(i.Tipo)</span>
                            <h6 class="mb-1">@i.Titulo</h6>
                            <p class="mb-1">@i.Descripcion</p>
                            @if (!string.IsNullOrWhiteSpace(i.NotasResolucion))
                            {
                                <p class="mb-1 small"><strong>Resolución:</strong> @i.NotasResolucion</p>
                            }
                            <small class="text-muted">
                                Resuelta por @(i.ResueltoPor?.Nombre ?? "-") · @i.FechaResolucion?.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <p id="incidenciasSinResultados" class="text-muted" hidden>Ninguna incidencia coincide con la búsqueda.</p>
}

@section Scripts {
    <script>activarFiltro('#filtroIncidencias', '#listaIncidencias .card', { vacio: '#incidenciasSinResultados' });</script>
}
