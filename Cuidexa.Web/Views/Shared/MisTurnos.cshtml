@model MisTurnosViewModel
<a href="/@Model.RutaBase" class="d-inline-block mb-2 text-decoration-none">&larr; Volver al panel</a>
<h4 class="mb-3"><i class="bi bi-calendar3 me-2 text-muted"></i>Mis turnos</h4>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="text-muted mb-1">Tu turno habitual</h6>
        @if (Model.PlantillaDefecto is null)
        {
            <p class="mb-0 text-danger small">No tienes un turno por defecto configurado — contacta con Admin.</p>
        }
        else
        {
            <p class="mb-0 fs-5">@Model.PlantillaDefecto.Nombre — @Model.PlantillaDefecto.HoraInicio.ToString("HH:mm")–@Model.PlantillaDefecto.HoraFin.ToString("HH:mm")</p>
            <p class="mb-0 text-muted small">Se asume todos los días, salvo un reemplazo o un cambio de turno aprobado para un día concreto.</p>
        }
    </div>
</div>

<h6 class="text-muted mb-2">Turnos especiales próximos</h6>
@if (!Model.TurnosEspeciales.Any())
{
    <p class="text-muted small">No tienes reemplazos ni cambios de turno próximos.</p>
}
else
{
    @foreach (var t in Model.TurnosEspeciales)
    {
        var esMio = t.EmpleadoId == Model.EmpleadoIdPropio;
        var badgeCambio = t.EsReemplazo ? "Reemplazo asignado por Admin" : $"Cubres a {t.EmpleadoOriginal?.Nombre ?? "un compañero"}";
        <div class="card mb-2">
            <div class="card-body">
                @if (esMio)
                {
                    <text><strong>@t.FechaInicio.ToString("dd/MM/yyyy HH:mm")</strong> — @t.FechaFin.ToString("HH:mm")</text>
                    <span class="badge @(t.EsReemplazo ? "bg-info text-dark" : "bg-warning text-dark") ms-2">@badgeCambio</span>
                    if (!string.IsNullOrWhiteSpace(t.MotivoReemplazo))
                    {
                        <div class="text-muted small mt-1">@t.MotivoReemplazo</div>
                    }
                }
                else
                {
                    <span class="badge bg-secondary">Cedido</span>
                    <text><span class="ms-2">El @t.FechaInicio.ToString("dd/MM/yyyy") te cubre @(t.Empleado?.Nombre ?? t.NombreExterno ?? "otro compañero") — no tienes que ir ese día.</span></text>
                }
            </div>
        </div>
    }
}

<h6 class="text-muted mt-4 mb-2">Solicitar cambio para un día</h6>
<div class="card mb-3">
    <div class="card-body">
        <form method="post" action="/@Model.RutaBase/SolicitarCambio" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-12 col-sm-3">
                <label class="form-label small mb-1">Fecha</label>
                <input type="date" name="fecha" class="form-control" required />
            </div>
            <div class="col-12 col-sm-4">
                <label class="form-label small mb-1">Motivo</label>
                <input name="motivo" class="form-control" placeholder="Motivo del cambio" required />
            </div>
            <div class="col-12 col-sm-3">
                <label class="form-label small mb-1">Proponer sustituto (opcional)</label>
                <select name="empleadoSustitutoPropuestoId" class="form-select">
                    <option value="">-- Mismo departamento --</option>
                    @foreach (var c in Model.Companeros)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-2">
                <button class="btn btn-outline-primary w-100">Solicitar</button>
            </div>
        </form>
    </div>
</div>

<h6 class="text-muted mb-2">Mis solicitudes de cambio</h6>
@if (!Model.MisCambios.Any())
{
    <p class="text-muted small">No has solicitado ningún cambio de turno todavía.</p>
}
else
{
    @foreach (var c in Model.MisCambios)
    {
        var claseBadge = c.Estado switch
        {
            EstadoCambioTurno.Aprobado => "bg-success",
            EstadoCambioTurno.Rechazado => "bg-danger",
            _ => "bg-warning text-dark"
        };
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@c.Fecha.ToString("dd/MM/yyyy")</strong>
                    <div class="text-muted small">@c.Motivo</div>
                    @if (c.EmpleadoSustitutoPropuesto != null)
                    {
                        <div class="text-muted small">Propuesto: @c.EmpleadoSustitutoPropuesto.Nombre</div>
                    }
                </div>
                <span class="badge @claseBadge">@c.Estado</span>
            </div>
        </div>
    }
}

<h5 class="mt-4 mb-2"><i class="bi bi-sun me-2 text-muted"></i>Mis vacaciones</h5>
<div class="card mb-3">
    <div class="card-body">
        <form method="post" action="/@Model.RutaBase/SolicitarVacaciones" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-6 col-sm-3">
                <label class="form-label small mb-1">Desde</label>
                <input type="date" name="fechaInicio" class="form-control" required />
            </div>
            <div class="col-6 col-sm-3">
                <label class="form-label small mb-1">Hasta</label>
                <input type="date" name="fechaFin" class="form-control" required />
            </div>
            <div class="col-12 col-sm-4">
                <label class="form-label small mb-1">Notas (opcional)</label>
                <input name="notas" class="form-control" placeholder="Motivo, referencia..." />
            </div>
            <div class="col-12 col-sm-2">
                <button class="btn btn-outline-primary w-100">Solicitar</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.MisVacaciones.Any())
{
    <p class="text-muted small">No has solicitado vacaciones todavía.</p>
}
else
{
    @foreach (var v in Model.MisVacaciones)
    {
        var claseBadge = v.Estado switch
        {
            EstadoVacacion.Aprobada => "bg-success",
            EstadoVacacion.Rechazada => "bg-danger",
            _ => "bg-warning text-dark"
        };
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@v.FechaInicio.ToString("dd/MM/yyyy")</strong> — @v.FechaFin.ToString("dd/MM/yyyy")
                    @if (!string.IsNullOrWhiteSpace(v.Notas))
                    {
                        <div class="text-muted small">@v.Notas</div>
                    }
                </div>
                <span class="badge @claseBadge">@v.Estado</span>
            </div>
        </div>
    }
}
