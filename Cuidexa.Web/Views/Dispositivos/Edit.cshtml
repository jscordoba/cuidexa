@model CuentaDispositivoEditDto
@{
    var roles = (RolEmpleado[])ViewBag.Roles;
}
<a href="/Dispositivos" class="d-inline-block mb-2 text-decoration-none">&larr; @Localizer["Volver a Dispositivos"]</a>
<h4 class="mb-3">@Localizer["Editar tablet"]</h4>
<form method="post" class="bg-white p-3 p-md-4 border rounded" style="max-width: 480px;">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <div class="mb-3">
        <label class="form-label">@Localizer["Nombre de la tablet"]</label>
        <input name="Nombre" class="form-control" value="@Model.Nombre" required />
    </div>
    <div class="mb-3">
        <label class="form-label">@Localizer["Departamento"]</label>
        <select name="Rol" class="form-select">
            @foreach (var rol in roles)
            {
                <option value="@rol" selected="@(rol == Model.Rol)">@RolPresentacion.Obtener(rol).Etiqueta</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">@Localizer["Nueva contraseña"]</label>
        <input type="password" name="NuevaPassword" class="form-control" minlength="8" placeholder="@Localizer["Dejar en blanco para no cambiarla"]" />
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-primary">@Localizer["Guardar cambios"]</button>
        <a href="/Dispositivos" class="btn btn-outline-secondary">@Localizer["Cancelar"]</a>
    </div>
</form>
