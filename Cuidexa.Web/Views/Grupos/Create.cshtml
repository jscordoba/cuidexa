@model GrupoNotificacionDto
@{
    var empleados = (List<Empleado>)ViewBag.Empleados;
    var centrosOrganizacion = ViewBag.CentrosOrganizacion as List<Centro>;
}
<a href="/Grupos" class="d-inline-block mb-2 text-decoration-none">&larr; Volver a Grupos</a>
<h4 class="mb-3">Nuevo grupo</h4>
<form method="post" class="bg-white p-3 p-md-4 border rounded" style="max-width: 480px;">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    @if (centrosOrganizacion is not null)
    {
        <div class="mb-3">
            <label class="form-label">Centro</label>
            <select name="centroId" class="form-select" required>
                @foreach (var c in centrosOrganizacion)
                {
                    <option value="@c.Id">@c.Nombre (@c.Codigo)</option>
                }
            </select>
            <div class="form-text">Los miembros del grupo deben pertenecer a este centro — el grupo entero vive en uno solo, igual que los avisos que genera.</div>
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Nombre del grupo</label>
        <input name="Nombre" class="form-control" value="@Model.Nombre" placeholder="Ej. Encargados de turno" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Miembros</label>
        <div class="d-flex flex-column gap-1" style="max-height: 320px; overflow-y: auto;">
            @foreach (var emp in empleados)
            {
                var (_, _, etiqueta) = RolPresentacion.Obtener(emp.Rol);
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="EmpleadoIds" value="@emp.Id" id="emp-@emp.Id" />
                    <label class="form-check-label" for="emp-@emp.Id">
                        @emp.Nombre <span class="text-muted small">(@etiqueta@(centrosOrganizacion is not null ? $" — {emp.Centro?.Nombre}" : ""))</span>
                    </label>
                </div>
            }
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-primary">Crear grupo</button>
        <a href="/Grupos" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
