@{
    var avisosPendientes = (int)ViewBag.AvisosPendientes;
    var tareasPendientes = (int)ViewBag.TareasPendientes;
    var claseUrgenciaAvisos = avisosPendientes == 0 ? "urgencia-ok" : avisosPendientes <= 2 ? "urgencia-media" : "urgencia-alta";
    var claseUrgenciaTareas = tareasPendientes == 0 ? "urgencia-ok" : tareasPendientes <= 2 ? "urgencia-media" : "urgencia-alta";
    var turnosEspeciales = (int)ViewBag.TurnosEspeciales;
}
@await Html.PartialAsync("_Saludo")

<div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-4">
        <a href="/Limpieza/Avisos" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard @claseUrgenciaAvisos">
            <div class="icono-dashboard i-rosa"><i class="bi bi-bell-fill"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Avisos pendientes"]</h6>
                <h2 class="mb-0">@avisosPendientes</h2>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a href="/Limpieza/Tareas" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard @claseUrgenciaTareas">
            <div class="icono-dashboard i-verde"><i class="bi bi-clipboard-check"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Tareas pendientes"]</h6>
                <h2 class="mb-0">@tareasPendientes</h2>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a href="/Limpieza/Turnos" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard">
            <div class="icono-dashboard i-morado"><i class="bi bi-calendar3"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Cambios y reemplazos"]</h6>
                <h2 class="mb-0">@turnosEspeciales</h2>
            </div>
        </a>
    </div>
</div>
