<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cuidexa · SuperAdmin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark" style="background: var(--navy);">
        <div class="container-fluid">
            <a class="navbar-brand" href="/SuperAdmin/Index"><i class="bi bi-hdd-stack-fill me-1"></i> Cuidexa · SuperAdmin</a>
            <a href="/SuperAdmin/Logout" class="btn btn-outline-light btn-sm">Salir</a>
        </div>
    </nav>
    <div class="container-fluid pt-3 pt-md-4 pb-5" style="max-width: 960px;">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @RenderBody()
    </div>
</body>
</html>
