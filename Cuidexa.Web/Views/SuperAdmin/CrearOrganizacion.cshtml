@{
    Layout = "_LayoutSuperAdmin";
}
<a href="/SuperAdmin/Index" class="d-inline-block mb-2 text-decoration-none">&larr; @Localizer["Volver"]</a>
<h4 class="mb-3">@Localizer["Nueva organización"]</h4>
<form method="post" class="bg-white p-3 p-md-4 border rounded" style="max-width: 480px;">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }
    <div class="mb-3">
        <label class="form-label">@Localizer["Nombre"]</label>
        <input name="nombre" class="form-control" required autofocus placeholder="@Localizer["Ej. Fundación Polibea"]" />
        <div class="form-text">@Localizer["La entidad gestora — puede tener varios centros físicos después."]</div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@Localizer["Crear organización"]</button>
        <a href="/SuperAdmin/Index" class="btn btn-outline-secondary">@Localizer["Cancelar"]</a>
    </div>
</form>
