@model List<TicketSoporte>
@{
    var abiertos = Model.Where(t => t.Estado == EstadoTicketSoporte.Abierto).ToList();
    var resueltos = Model.Where(t => t.Estado == EstadoTicketSoporte.Resuelto).ToList();
}
<h4 class="mb-3"><i class="bi bi-life-preserver me-2 text-muted"></i>Soporte</h4>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="mb-1">Reportar un problema</h5>
        <p class="text-muted small">
            Cuéntanos qué esperabas que pasara, qué ha pasado en realidad y en qué pantalla —
            con eso normalmente basta para investigarlo. Tu equipo de soporte responde aquí mismo,
            no hace falta que revises el correo.
        </p>
        <form method="post" action="/Soporte/Crear">
            @Html.AntiForgeryToken()
            <div class="mb-2">
                <label class="form-label">Título</label>
                <input name="titulo" class="form-control" required maxlength="150" placeholder="Resumen corto del problema" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea name="descripcion" class="form-control" rows="4" required placeholder="Qué esperabas, qué ha pasado, en qué pantalla..."></textarea>
            </div>
            <button class="btn btn-primary">Enviar</button>
        </form>
    </div>
</div>

@if (abiertos.Any())
{
    <h6 class="text-muted">Pendientes de respuesta</h6>
    @foreach (var t in abiertos)
    {
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h6 class="mb-1">@t.Titulo</h6>
                    <span class="badge bg-warning text-dark">Pendiente</span>
                </div>
                <p class="mb-1">@t.Descripcion</p>
                <small class="text-muted">Enviado por @(t.Empleado?.Nombre ?? "-") · @t.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
        </div>
    }
}

@if (resueltos.Any())
{
    <h6 class="text-muted mt-3">Resueltos</h6>
    @foreach (var t in resueltos)
    {
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h6 class="mb-1">@t.Titulo</h6>
                    <span class="badge bg-success">Resuelto</span>
                </div>
                <p class="mb-1">@t.Descripcion</p>
                <small class="text-muted">Enviado por @(t.Empleado?.Nombre ?? "-") · @t.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                @if (!string.IsNullOrWhiteSpace(t.Respuesta))
                {
                    <div class="alert alert-light border mt-2 mb-0 small">
                        <strong>Respuesta:</strong> @t.Respuesta
                        <div class="text-muted">@t.FechaRespuesta?.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>
    }
}

@if (!Model.Any())
{
    <p class="text-muted">Todavía no has enviado ninguna incidencia de soporte.</p>
}
