@model List<SesionTerapia>
<a href="/Profesionales" class="d-inline-block mb-2 text-decoration-none">&larr; Volver al panel</a>
<h4 class="mb-3"><i class="bi bi-calendar2-week me-2 text-muted"></i>Mi agenda</h4>

@if (!Model.Any())
{
    <p class="text-muted">No tienes sesiones programadas.</p>
}
else
{
    <input type="search" id="filtroAgenda" class="form-control mb-2" placeholder="Buscar en la agenda..." />
    <div id="listaAgenda">
        @foreach (var s in Model)
        {
            <a href="/Profesionales/Details/@s.ResidenteId" class="card mb-2 text-decoration-none text-body">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <strong>@s.Residente?.Nombre @s.Residente?.Apellidos</strong>
                    <span class="text-muted text-nowrap">@s.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </a>
        }
    </div>
    <p id="agendaSinResultados" class="text-muted" hidden>Ninguna sesión coincide con la búsqueda.</p>
}

@section Scripts {
    <script>activarFiltro('#filtroAgenda', '#listaAgenda > a', { vacio: '#agendaSinResultados' });</script>
}
