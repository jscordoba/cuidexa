@using Cuidexa.Web.Services
@model List<Empleado>
@{
    var empleadoIdActual = (int?)ViewBag.EmpleadoIdActual;
    var mostrarCentro = (bool)ViewBag.MostrarCentro;
}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <h4 class="mb-0">@Localizer["Usuarios"]</h4>
    <a class="btn btn-primary" href="/Empleados/Create">+ @Localizer["Nuevo usuario"]</a>
</div>
<input type="search" id="filtroEmpleados" class="form-control mb-3" placeholder="@Localizer["Buscar por nombre, email, rol..."]" />
<div class="table-responsive">
    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>@Localizer["Nombre"]</th><th>@Localizer["Email"]</th><th>@Localizer["Rol"]</th><th>@Localizer["Especialidad"]</th>
                @if (mostrarCentro)
                {
                    <th>@Localizer["Centro"]</th>
                }
                <th>@Localizer["Estado"]</th><th></th>
            </tr>
        </thead>
        <tbody id="listaEmpleados">
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Nombre</td>
                    <td>@e.Email</td>
                    <td>@RolPresentacion.Obtener(e.Rol).Etiqueta</td>
                    <td>@(e.Especialidad?.Nombre ?? "-")</td>
                    @if (mostrarCentro)
                    {
                        <td>@e.Centro?.Nombre</td>
                    }
                    <td>
                        <span class="badge @(e.Activo ? "bg-success" : "bg-secondary")">@(e.Activo ? Localizer["Activo"] : Localizer["Inactivo"])</span>
                        @if (BloqueoCuenta.EstaBloqueada(e))
                        {
                            <span class="badge bg-warning text-dark" title="@Localizer["Bloqueada por fuerza bruta — resetea su contraseña en Editar para desbloquearla al instante."]">@Localizer["Bloqueado"]</span>
                        }
                    </td>
                    <td class="d-flex flex-column flex-sm-row gap-2">
                        <a href="/Empleados/Edit/@e.Id" class="btn btn-sm btn-outline-secondary text-nowrap">@Localizer["Editar"]</a>
                        @if (e.Id != empleadoIdActual)
                        {
                            <form method="post" action="/Empleados/CambiarEstado">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <input type="hidden" name="activo" value="@(!e.Activo ? "true" : "false")" />
                                <button class="btn btn-sm @(e.Activo ? "btn-outline-danger" : "btn-outline-success") text-nowrap">
                                    @(e.Activo ? Localizer["Desactivar"] : Localizer["Activar"])
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p id="empleadosSinResultados" class="text-muted" hidden>@Localizer["Ningún usuario coincide con la búsqueda."]</p>
</div>

@section Scripts {
    <script>activarFiltro('#filtroEmpleados', '#listaEmpleados tr', { vacio: '#empleadosSinResultados' });</script>
}
