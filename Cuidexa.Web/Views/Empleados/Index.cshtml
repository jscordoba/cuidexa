@using Cuidexa.Web.Services
@model List<Empleado>
@{
    var empleadoIdActual = (int?)ViewBag.EmpleadoIdActual;
    var mostrarCentro = (bool)ViewBag.MostrarCentro;
}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <h4 class="mb-0">Usuarios</h4>
    <a class="btn btn-primary" href="/Empleados/Create">+ Nuevo usuario</a>
</div>
<input type="search" id="filtroEmpleados" class="form-control mb-3" placeholder="Buscar por nombre, email, rol..." />
<div class="table-responsive">
    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>Nombre</th><th>Email</th><th>Rol</th><th>Especialidad</th>
                @if (mostrarCentro)
                {
                    <th>Centro</th>
                }
                <th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody id="listaEmpleados">
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Nombre</td>
                    <td>@e.Email</td>
                    <td>@e.Rol</td>
                    <td>@(e.Especialidad?.Nombre ?? "-")</td>
                    @if (mostrarCentro)
                    {
                        <td>@e.Centro?.Nombre</td>
                    }
                    <td>
                        <span class="badge @(e.Activo ? "bg-success" : "bg-secondary")">@(e.Activo ? "Activo" : "Inactivo")</span>
                        @if (BloqueoCuenta.EstaBloqueada(e))
                        {
                            <span class="badge bg-warning text-dark" title="Bloqueada por fuerza bruta — resetea su contraseña en Editar para desbloquearla al instante.">Bloqueado</span>
                        }
                    </td>
                    <td class="d-flex flex-column flex-sm-row gap-2">
                        <a href="/Empleados/Edit/@e.Id" class="btn btn-sm btn-outline-secondary text-nowrap">Editar</a>
                        @if (e.Id != empleadoIdActual)
                        {
                            <form method="post" action="/Empleados/CambiarEstado">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <input type="hidden" name="activo" value="@(!e.Activo ? "true" : "false")" />
                                <button class="btn btn-sm @(e.Activo ? "btn-outline-danger" : "btn-outline-success") text-nowrap">
                                    @(e.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p id="empleadosSinResultados" class="text-muted" hidden>Ningún usuario coincide con la búsqueda.</p>
</div>

@section Scripts {
    <script>activarFiltro('#filtroEmpleados', '#listaEmpleados tr', { vacio: '#empleadosSinResultados' });</script>
}
