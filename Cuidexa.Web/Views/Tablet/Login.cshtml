@{
    Layout = null;
    // Marca genérica siempre — mismo motivo que Account/Login.cshtml: aquí
    // todavía no se sabe a qué organización pertenece esta tablet.
    const string nombreCentro = "Cuidexa";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@nombreCentro · Tablet</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .pantalla-acceso {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, #eef2ff 0%, #f8f9fa 40%);
            padding: 1.75rem 1rem;
        }
        .tarjeta-acceso { width: 100%; max-width: 380px; }
        .logo-cuidexa {
            width: 4.25rem; height: 4.25rem; border-radius: 50%;
            background: linear-gradient(135deg, #06b6d4, #4f46e5);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 2rem; margin: 0 auto 1rem;
            box-shadow: 0 10px 24px rgba(79, 70, 229, .28);
        }
        .form-acceso .input-group-text { background: #fff; border-right: none; color: #6c757d; }
        .form-acceso .form-control { border-left: none; }
        .form-acceso .form-control:focus { box-shadow: none; border-color: #ced4da; }
        .form-acceso .input-group:focus-within { box-shadow: 0 0 0 .25rem rgba(79, 70, 229, .15); border-radius: .5rem; }
        .btn-acceso { background: var(--enlace-color); border: none; color: #fff; }
        .btn-acceso:hover { background: var(--enlace-color-hover); color: #fff; }
    </style>
</head>
<body>
    <div class="pantalla-acceso">
        <div class="tarjeta-acceso">
            <div class="text-center mb-4">
                <div class="logo-cuidexa"><i class="bi bi-tablet"></i></div>
                <h1 class="h4 mb-1 fw-bold" style="color:var(--navy)">@nombreCentro</h1>
                <p class="text-muted small mb-0">Tablet compartida de departamento</p>
            </div>

            <div class="card border-0 shadow-sm p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@e.ErrorMessage</div>
                        }
                    </div>
                }
                <form method="post" class="form-acceso">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small text-muted">Código de centro</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-building"></i></span>
                            <input name="codigoCentro" class="form-control text-uppercase" required autofocus autocomplete="off" value="DEMO" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Nombre de la tablet</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tablet"></i></span>
                            <input name="nombre" class="form-control" required autocomplete="username" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" name="password" class="form-control" required autocomplete="current-password" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-acceso w-100 py-2 fw-semibold">Entrar</button>
                </form>
            </div>

            <p class="text-muted small text-center mt-3 mb-0">Esta sesión queda abierta en el dispositivo — pídela a Admin si no la tienes.</p>
        </div>
    </div>
</body>
</html>
