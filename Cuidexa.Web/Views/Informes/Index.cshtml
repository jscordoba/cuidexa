@{
    var desde = (DateOnly)ViewBag.Desde;
    var hasta = (DateOnly)ViewBag.Hasta;
    var turnos = (InformeTurnosPersonal)ViewBag.TurnosPersonal;
    var residentes = (InformeResidentesCuidados)ViewBag.ResidentesCuidados;
    var actividad = (InformeActividadIncidencias)ViewBag.ActividadIncidencias;
    var qs = $"desde={desde:yyyy-MM-dd}&hasta={hasta:yyyy-MM-dd}";
}
<h4 class="mb-3">Informes</h4>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-6 col-sm-3">
        <label class="form-label small mb-1">Desde</label>
        <input type="date" name="desde" class="form-control" value="@desde.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-sm-3">
        <label class="form-label small mb-1">Hasta</label>
        <input type="date" name="hasta" class="form-control" value="@hasta.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-sm-3">
        <button class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h5 class="mb-0">Turnos y personal</h5>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/Informes/TurnosPdf?@qs">Descargar PDF</a>
                <a class="btn btn-sm btn-outline-secondary" href="/Informes/TurnosExcel?@qs">Descargar Excel</a>
            </div>
        </div>
        <p class="text-muted small">"Ausencias" = días en que a la persona le cubrieron su turno (única señal de ausencia disponible hoy).</p>
        @if (!turnos.Filas.Any())
        {
            <p class="text-muted small mb-0">Sin turnos en el rango.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm bg-white">
                    <thead><tr><th>Empleado</th><th>Rol</th><th>Horas</th><th>Ausencias</th><th>Vac. disfrutadas</th><th>Vac. solicitadas</th></tr></thead>
                    <tbody>
                        @foreach (var f in turnos.Filas)
                        {
                            <tr>
                                <td>@f.Nombre</td>
                                <td>@f.Rol</td>
                                <td>@f.HorasTrabajadas.ToString("0.0")</td>
                                <td>@f.DiasAusencia</td>
                                <td>@f.VacacionesDisfrutadas</td>
                                <td>@f.VacacionesSolicitadas</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h5 class="mb-0">Residentes y cuidados</h5>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/Informes/ResidentesPdf?@qs">Descargar PDF</a>
                <a class="btn btn-sm btn-outline-secondary" href="/Informes/ResidentesExcel?@qs">Descargar Excel</a>
            </div>
        </div>

        <h6 class="text-muted">Dietas activas <span class="fw-normal">(a fecha de hoy)</span></h6>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var (dieta, cantidad) in residentes.DietasActivas)
            {
                <span class="badge bg-light text-dark border">@dieta: @cantidad</span>
            }
        </div>

        <h6 class="text-muted">Patologías más frecuentes <span class="fw-normal">(a fecha de hoy)</span></h6>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (!residentes.PatologiasFrecuentes.Any())
            {
                <span class="text-muted small">Ninguna registrada.</span>
            }
            @foreach (var (patologia, cantidad) in residentes.PatologiasFrecuentes)
            {
                <span class="badge bg-light text-dark border">@patologia: @cantidad</span>
            }
        </div>

        <h6 class="text-muted">Medicación administrada en el rango</h6>
        @if (!residentes.MedicacionAdministrada.Any())
        {
            <p class="text-muted small">Sin registros en el rango.</p>
        }
        else
        {
            <ul class="small mb-3">
                @foreach (var m in residentes.MedicacionAdministrada)
                {
                    <li>@m.Residente — @m.Medicamento: @m.VecesAdministrada veces</li>
                }
            </ul>
        }

        <h6 class="text-muted">Sesiones de terapia realizadas en el rango</h6>
        @if (!residentes.SesionesRealizadas.Any())
        {
            <p class="text-muted small mb-0">Sin registros en el rango.</p>
        }
        else
        {
            <ul class="small mb-0">
                @foreach (var s in residentes.SesionesRealizadas)
                {
                    <li>@s.Residente — @s.Profesional (@s.Especialidad): @s.SesionesRealizadas sesiones</li>
                }
            </ul>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h5 class="mb-0">Actividad e incidencias</h5>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/Informes/ActividadPdf?@qs">Descargar PDF</a>
                <a class="btn btn-sm btn-outline-secondary" href="/Informes/ActividadExcel?@qs">Descargar Excel</a>
            </div>
        </div>

        <h6 class="text-muted">Avisos por departamento</h6>
        @if (!actividad.AvisosPorDepartamento.Any())
        {
            <p class="text-muted small">Sin avisos en el rango.</p>
        }
        else
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm bg-white">
                    <thead><tr><th>Departamento</th><th>Total</th><th>Urgentes</th></tr></thead>
                    <tbody>
                        @foreach (var f in actividad.AvisosPorDepartamento)
                        {
                            <tr><td>@f.Rol</td><td>@f.Total</td><td>@f.Urgentes</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h6 class="text-muted">Altas, bajas y traslados de residentes</h6>
        @if (!actividad.TendenciaResidentes.Any())
        {
            <p class="text-muted small mb-0">Sin movimientos en el rango.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var (accion, cantidad) in actividad.TendenciaResidentes)
                {
                    <span class="badge bg-light text-dark border">@accion: @cantidad</span>
                }
            </div>
        }
    </div>
</div>
