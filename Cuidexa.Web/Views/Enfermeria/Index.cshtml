@{
    var avisosPendientes = (int)ViewBag.AvisosPendientes;
    var medicacionPendiente = (int)ViewBag.MedicacionPendiente;
    var residentesActivos = (int)ViewBag.ResidentesActivos;
    var turnosEspeciales = (int)ViewBag.TurnosEspeciales;
    var claseUrgenciaAvisos = avisosPendientes == 0 ? "urgencia-ok" : avisosPendientes <= 2 ? "urgencia-media" : "urgencia-alta";
    var claseUrgenciaMedicacion = medicacionPendiente == 0 ? "urgencia-ok" : medicacionPendiente <= 2 ? "urgencia-media" : "urgencia-alta";
}
@await Html.PartialAsync("_Saludo")

<div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="/Enfermeria/Avisos" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard @claseUrgenciaAvisos">
            <div class="icono-dashboard i-rosa"><i class="bi bi-bell-fill"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Avisos pendientes"]</h6>
                <h2 class="mb-0">@avisosPendientes</h2>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="/Enfermeria/Agenda" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard @claseUrgenciaMedicacion">
            <div class="icono-dashboard i-cian"><i class="bi bi-capsule"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Medicación pendiente hoy"]</h6>
                <h2 class="mb-0">@medicacionPendiente</h2>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="/Enfermeria/Residentes" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard">
            <div class="icono-dashboard i-azul"><i class="bi bi-people-fill"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Residentes activos"]</h6>
                <h2 class="mb-0">@residentesActivos</h2>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="/Enfermeria/Turnos" class="card h-100 text-decoration-none text-body tarjeta-resumen tarjeta-dashboard">
            <div class="icono-dashboard i-morado"><i class="bi bi-calendar3"></i></div>
            <div>
                <h6 class="text-muted mb-1">@Localizer["Cambios y reemplazos"]</h6>
                <h2 class="mb-0">@turnosEspeciales</h2>
            </div>
        </a>
    </div>
</div>
