@model List<AgendaMedicacionItem>
<a href="/Enfermeria" class="d-inline-block mb-2 text-decoration-none">&larr; Volver al panel</a>
<h4 class="mb-3"><i class="bi bi-capsule me-2 text-muted"></i>Agenda de hoy</h4>

@if (!Model.Any())
{
    <p class="text-muted">No hay medicación activa registrada.</p>
}
else
{
    <input type="search" id="filtroAgenda" class="form-control mb-2" placeholder="Buscar en la agenda..." />
    <div id="listaAgenda">
        @foreach (var a in Model)
        {
            <div class="card mb-2 @(a.AdministradaHoy ? "" : "border-warning")">
                <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div>
                        <strong>@a.ResidenteNombre</strong> — @a.Nombre (@a.Dosis)
                        <br />
                        <small class="text-muted">@a.Horario</small>
                    </div>
                    @if (a.AdministradaHoy)
                    {
                        <span class="badge bg-success text-nowrap align-self-start align-self-sm-center">Administrada hoy</span>
                    }
                    else
                    {
                        <form method="post" action="/Enfermeria/RegistrarAdministracion">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="residenteId" value="@a.ResidenteId" />
                            <input type="hidden" name="medicacionId" value="@a.MedicacionId" />
                            <input type="hidden" name="volver" value="Agenda" />
                            <button class="btn btn-sm btn-outline-primary text-nowrap">Registrar administración</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
    <p id="agendaSinResultados" class="text-muted" hidden>Ninguna entrada coincide con la búsqueda.</p>
}

@section Scripts {
    <script>activarFiltro('#filtroAgenda', '#listaAgenda > .card', { vacio: '#agendaSinResultados' });</script>
}
