@model List<Residente>
<a href="/Enfermeria" class="d-inline-block mb-2 text-decoration-none">&larr; Volver al panel</a>
<h4 class="mb-3"><i class="bi bi-people-fill me-2 text-muted"></i>Residentes</h4>

@if (!Model.Any())
{
    <p class="text-muted">No hay residentes activos.</p>
}
else
{
    <input type="search" id="filtroResidentes" class="form-control mb-2" placeholder="Buscar residente..." />
    <div id="listaResidentes">
        @foreach (var r in Model)
        {
            var medicacionesActivas = r.Medicaciones.Count(m => m.FechaFin == null);
            <a href="/Enfermeria/Details/@r.Id" class="card mb-2 text-decoration-none text-body">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@r.Nombre @r.Apellidos</strong>
                        <br />
                        <small class="text-muted">
                            @(r.Patologias.Count > 0 ? string.Join(", ", r.Patologias.Select(p => p.Patologia?.Nombre)) : "Sin patologías registradas")
                        </small>
                    </div>
                    <span class="badge bg-secondary text-nowrap">@medicacionesActivas medicación(es)</span>
                </div>
            </a>
        }
    </div>
    <p id="residentesSinResultados" class="text-muted" hidden>Ningún residente coincide con la búsqueda.</p>
}

@section Scripts {
    <script>activarFiltro('#filtroResidentes', '#listaResidentes > a', { vacio: '#residentesSinResultados' });</script>
}
