@model List<Vacacion>
@{
    ViewBag.SeccionActual = "Vacaciones";
    var pendientes = (List<Vacacion>)ViewBag.Pendientes;
    var resumen = (List<ResumenVacacionesEmpleado>)ViewBag.Resumen;
    var feriados = (List<Feriado>)ViewBag.Feriados;
    var diasPorVacacion = (Dictionary<int, int>)ViewBag.DiasPorVacacion;
    var centroVb = (Centro)ViewBag.Centro;

    string EtiquetaVacacion(EstadoVacacion e) => e switch
    {
        EstadoVacacion.Aprobada => Localizer["Aprobada"],
        EstadoVacacion.Rechazada => Localizer["Rechazada"],
        _ => Localizer["Solicitada"]
    };
}
@await Html.PartialAsync("_SubNav")

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <h4 class="mb-0">@Localizer["Vacaciones"]</h4>
    <a class="btn btn-primary" href="/Turnos/RegistrarVacacion">+ @Localizer["Registrar vacaciones"]</a>
</div>

<p class="text-muted small">@Localizer["Los días de vacaciones se cuentan solo en días laborables (sin fines de semana ni festivos), salvo que se marque \"incluye fines de semana y festivos\" al registrar o aprobar una solicitud."]</p>

<button class="toggle-colapsable mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#gestionFestivos">
    @Localizer["Gestionar festivos del centro"] (@feriados.Count) <span class="caret">&#9662;</span>
</button>
<div class="collapse mb-4" id="gestionFestivos">
    <div class="card">
        <div class="card-body">
            <div class="mb-3 pb-3 border-bottom">
                <form method="post" action="/Turnos/ActualizarComunidad" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-8 col-sm-6">
                        <label class="form-label small mb-1">@Localizer["Comunidad autónoma del centro"]</label>
                        <select name="comunidad" class="form-select">
                            <option value="">-- @Localizer["Sin definir"] --</option>
                            @foreach (var c in Enum.GetValues<ComunidadAutonoma>())
                            {
                                var (etiquetaC, _) = ComunidadPresentacion.Obtener(c);
                                <option value="@c" selected="@(c == centroVb.ComunidadAutonoma)">@etiquetaC</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 col-sm-3">
                        <button class="btn btn-outline-secondary w-100">@Localizer["Guardar"]</button>
                    </div>
                </form>

                <form method="post" action="/Turnos/ImportarFestivos" class="row g-2 align-items-end mt-2">
                    @Html.AntiForgeryToken()
                    <div class="col-8 col-sm-6">
                        <label class="form-label small mb-1">@Localizer["Importar festivos oficiales del año"]</label>
                        <input type="number" name="anio" class="form-control" value="@DateTime.Today.Year" min="2020" max="2100" />
                    </div>
                    <div class="col-4 col-sm-3">
                        <button class="btn btn-outline-primary w-100" @(centroVb.ComunidadAutonoma is null ? "disabled" : "")>@Localizer["Importar"]</button>
                    </div>
                </form>
                <p class="text-muted small mb-0 mt-2">
                    @if (centroVb.ComunidadAutonoma is null)
                    {
                        <text>@Localizer["Define la comunidad autónoma del centro para poder importar su calendario laboral."]</text>
                    }
                    else
                    {
                        <text>@Localizer["Fuente: calendariosnacionales.com (agrega BOE y boletines autonómicos oficiales, no es una API del gobierno) — revisa siempre el resultado tras importar."]</text>
                    }
                </p>
            </div>

            <form method="post" action="/Turnos/CrearFeriado" class="row g-2 align-items-end mb-3">
                @Html.AntiForgeryToken()
                <div class="col-6 col-sm-4">
                    <label class="form-label small mb-1">@Localizer["Fecha"]</label>
                    <input type="date" name="fecha" class="form-control" required />
                </div>
                <div class="col-6 col-sm-5">
                    <label class="form-label small mb-1">@Localizer["Nombre (opcional)"]</label>
                    <input name="nombre" class="form-control" placeholder="@Localizer["Ej. Navidad"]" />
                </div>
                <div class="col-12 col-sm-3">
                    <button class="btn btn-outline-primary w-100">@Localizer["Añadir festivo"]</button>
                </div>
            </form>

            @if (!feriados.Any())
            {
                <p class="text-muted small mb-0">@Localizer["No hay festivos registrados."]</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var f in feriados)
                    {
                        <form method="post" action="/Turnos/EliminarFeriado" class="d-flex align-items-center gap-1 border rounded px-2 py-1">
                            @Html.AntiForgeryToken()
                            <span class="small">@f.Fecha.ToString("dd/MM/yyyy")@(string.IsNullOrWhiteSpace(f.Nombre) ? "" : $" — {f.Nombre}")</span>
                            <input type="hidden" name="id" value="@f.Id" />
                            <button class="btn btn-sm btn-link text-danger p-0" title="@Localizer["Eliminar"]" onclick="return confirm('@Localizer["¿Eliminar este festivo?"]');">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>

<h6 class="text-muted mb-2">@Localizer["Resumen por empleado"]</h6>
@if (!resumen.Any())
{
    <p class="text-muted small">@Localizer["Sin vacaciones registradas todavía."]</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-sm bg-white">
            <thead><tr><th>@Localizer["Empleado"]</th><th>@Localizer["Departamento"]</th><th>@Localizer["Días disfrutados"]</th><th>@Localizer["Días solicitados (pendientes)"]</th></tr></thead>
            <tbody>
                @foreach (var r in resumen)
                {
                    var (_, _, etiquetaR) = RolPresentacion.Obtener(r.Rol);
                    <tr>
                        <td>@r.Nombre</td>
                        <td>@etiquetaR</td>
                        <td>@r.DiasDisfrutados</td>
                        <td>@r.DiasSolicitados</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h6 class="text-muted mb-2">@Localizer["Solicitudes pendientes"]</h6>
@if (!pendientes.Any())
{
    <p class="text-muted small">@Localizer["No hay solicitudes pendientes."]</p>
}
else
{
    @foreach (var v in pendientes)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@v.Empleado?.Nombre</strong>
                    <div class="text-muted small">@v.FechaInicio.ToString("dd/MM/yyyy") — @v.FechaFin.ToString("dd/MM/yyyy") (@diasPorVacacion[v.Id] @Localizer["días laborables"])</div>
                    @if (!string.IsNullOrWhiteSpace(v.Notas))
                    {
                        <div class="text-muted small">@v.Notas</div>
                    }
                </div>
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <form method="post" action="/Turnos/AprobarVacacion" class="d-flex align-items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@v.Id" />
                        <div class="form-check mb-0">
                            <input type="checkbox" class="form-check-input" name="incluyeFinesSemanaYFestivos" value="true" id="incluye@(v.Id)" />
                            <label class="form-check-label small text-nowrap" for="incluye@(v.Id)">@Localizer["Incluir fin de semana/festivos"]</label>
                        </div>
                        <button class="btn btn-sm btn-outline-primary text-nowrap">@Localizer["Aprobar"]</button>
                    </form>
                    <form method="post" action="/Turnos/RechazarVacacion">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@v.Id" />
                        <button class="btn btn-sm btn-outline-danger">@Localizer["Rechazar"]</button>
                    </form>
                </div>
            </div>
        </div>
    }
}

<h6 class="text-muted mt-4 mb-2">@Localizer["Historial completo"]</h6>
@if (!Model.Any())
{
    <p class="text-muted small">@Localizer["Sin registros."]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm bg-white">
            <thead><tr><th>@Localizer["Empleado"]</th><th>@Localizer["Desde"]</th><th>@Localizer["Hasta"]</th><th>@Localizer["Días"]</th><th>@Localizer["Estado"]</th></tr></thead>
            <tbody>
                @foreach (var v in Model)
                {
                    var claseBadge = v.Estado switch
                    {
                        EstadoVacacion.Aprobada => "bg-success",
                        EstadoVacacion.Rechazada => "bg-danger",
                        _ => "bg-warning text-dark"
                    };
                    <tr>
                        <td>@v.Empleado?.Nombre</td>
                        <td>@v.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@v.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>
                            @diasPorVacacion[v.Id]
                            @if (v.IncluyeFinesSemanaYFestivos)
                            {
                                <span class="badge bg-secondary ms-1" title="@Localizer["Incluye fines de semana y festivos"]">+FS</span>
                            }
                        </td>
                        <td><span class="badge @claseBadge">@EtiquetaVacacion(v.Estado)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
