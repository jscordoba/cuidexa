@model PlantillaTurno
@{
    string EtiquetaTipoDia(TipoDia t) => t switch
    {
        TipoDia.Laborable => Localizer["Laborable"],
        TipoDia.Festivo => Localizer["Festivo"],
        TipoDia.FinDeSemana => Localizer["Fin de semana"],
        _ => t.ToString()
    };
}
<a href="/Turnos/Plantillas" class="d-inline-block mb-2 text-decoration-none">&larr; @Localizer["Volver a Plantillas"]</a>
<h4 class="mb-3">@Localizer["Editar plantilla"]</h4>
<form method="post" class="bg-white p-3 p-md-4 border rounded" style="max-width: 480px;">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">@Localizer["Nombre"]</label>
        <input name="nombre" class="form-control" value="@Model.Nombre" required />
    </div>
    <div class="row">
        <div class="col-6 mb-3">
            <label class="form-label">@Localizer["Hora inicio"]</label>
            <input type="time" name="horaInicio" class="form-control" value="@Model.HoraInicio.ToString("HH:mm")" required />
        </div>
        <div class="col-6 mb-3">
            <label class="form-label">@Localizer["Hora fin"]</label>
            <input type="time" name="horaFin" class="form-control" value="@Model.HoraFin.ToString("HH:mm")" required />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">@Localizer["Tipo de día"]</label>
        <select name="tipoDia" class="form-select">
            @foreach (var tipo in Enum.GetValues<TipoDia>())
            {
                <option value="@tipo" selected="@(tipo == Model.TipoDia)">@EtiquetaTipoDia(tipo)</option>
            }
        </select>
    </div>
    <div class="d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-primary">@Localizer["Guardar cambios"]</button>
        <a href="/Turnos/Plantillas" class="btn btn-outline-secondary">@Localizer["Cancelar"]</a>
    </div>
</form>
