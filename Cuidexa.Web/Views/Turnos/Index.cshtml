@model List<Turno>
@{
    ViewBag.SeccionActual = "Turnos";
    var mostrarCentro = (bool)ViewBag.MostrarCentro;
}
@await Html.PartialAsync("_SubNav")

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <h4 class="mb-0">Turnos</h4>
    <a class="btn btn-primary" href="/Turnos/Create">+ Nuevo turno</a>
</div>

<div class="mb-3">
    <label class="text-muted small d-block mb-1">Filtrar por departamento</label>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroRolesBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
            <span id="filtroRolesResumen">Todos los departamentos</span>
        </button>
        <ul class="dropdown-menu p-2" aria-labelledby="filtroRolesBtn">
            @foreach (var rol in Enum.GetValues<RolEmpleado>().Where(r => r != RolEmpleado.Admin && r != RolEmpleado.Direccion && r != RolEmpleado.DirectorOrganizacion))
            {
                var (_, _, etiqueta) = RolPresentacion.Obtener(rol);
                <li>
                    <div class="form-check">
                        <input class="form-check-input filtro-rol-check" type="checkbox" value="@rol" id="rolChk@(rol)" checked />
                        <label class="form-check-label" for="rolChk@(rol)">@etiqueta</label>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
<input type="search" id="filtroTurnos" class="form-control mb-3" placeholder="Buscar por empleado, estado..." />
<div class="table-responsive">
    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>Rol</th><th>Titular</th><th>Inicio</th><th>Fin</th>
                @if (mostrarCentro)
                {
                    <th>Centro</th>
                }
                <th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody id="listaTurnos">
            @foreach (var t in Model)
            {
                <tr data-rol="@t.Rol">
                    <td>@t.Rol</td>
                    <td>
                        @(t.Empleado?.Nombre ?? t.NombreExterno ?? "-") @(t.EmpleadoId is null && !string.IsNullOrWhiteSpace(t.NombreExterno) ? "(externo)" : "")
                        @if (t.EsReemplazo)
                        {
                            <span class="badge bg-info text-dark ms-1">Reemplazo</span>
                        }
                        @if (t.EsCambio)
                        {
                            <span class="badge bg-warning text-dark ms-1">Cambio</span>
                        }
                    </td>
                    <td>@t.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@t.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>
                    @if (mostrarCentro)
                    {
                        <td>@t.Centro?.Nombre</td>
                    }
                    <td>
                        <span class="badge @(t.Estado == EstadoTurno.Programado ? "bg-success" : t.Estado == EstadoTurno.Completado ? "bg-secondary" : "bg-danger")">@t.Estado</span>
                    </td>
                    <td class="d-flex flex-column flex-sm-row gap-1">
                        <a href="/Turnos/Editar/@t.Id" class="btn btn-sm btn-outline-secondary text-nowrap">Editar</a>
                        <a href="/Turnos/Historial?turnoId=@t.Id" class="btn btn-sm btn-outline-secondary text-nowrap">Historial</a>
                        @if (t.Estado == EstadoTurno.Programado)
                        {
                            <form method="post" action="/Turnos/Cancelar" onsubmit="return confirm('¿Cancelar este turno?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger text-nowrap">Cancelar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p id="turnosSinResultados" class="text-muted" hidden>Ningún turno coincide con la búsqueda.</p>
</div>

@section Scripts {
    <script>
        const filtroTexto = document.getElementById('filtroTurnos');
        const checksRol = document.querySelectorAll('.filtro-rol-check');
        const resumenRoles = document.getElementById('filtroRolesResumen');
        const filasTurno = document.querySelectorAll('#listaTurnos tr');
        const sinResultados = document.getElementById('turnosSinResultados');

        function actualizarResumenRoles(marcados) {
            if (marcados.length === checksRol.length) {
                resumenRoles.textContent = 'Todos los departamentos';
            } else if (marcados.length === 0) {
                resumenRoles.textContent = 'Ningún departamento';
            } else {
                resumenRoles.textContent = marcados.map(c => c.nextElementSibling.textContent).join(', ');
            }
        }

        function aplicarFiltrosTurnos() {
            const texto = filtroTexto.value.trim().toLowerCase();
            const marcados = Array.from(checksRol).filter(c => c.checked);
            const rolesActivos = new Set(marcados.map(c => c.value));
            let visibles = 0;

            filasTurno.forEach(fila => {
                const coincideTexto = texto === '' || fila.textContent.toLowerCase().includes(texto);
                const coincideRol = rolesActivos.has(fila.dataset.rol);
                const visible = coincideTexto && coincideRol;
                fila.hidden = !visible;
                if (visible) visibles++;
            });

            actualizarResumenRoles(marcados);
            sinResultados.hidden = visibles !== 0;
        }

        filtroTexto.addEventListener('input', aplicarFiltrosTurnos);
        checksRol.forEach(c => c.addEventListener('change', aplicarFiltrosTurnos));
    </script>
}
