@{
    var empleados = (List<Empleado>)ViewBag.Empleados;
}
<a href="/Turnos/Reemplazos" class="d-inline-block mb-2 text-decoration-none">&larr; @Localizer["Volver a Reemplazos"]</a>
<h4 class="mb-3">@Localizer["Asignar reemplazo por ausencia"]</h4>
<p class="text-muted">@Localizer["El turno se asigna de inmediato al empleado elegido y aparecerá resaltado como \"Reemplazo\" en su pantalla de Mis turnos."]</p>
<form method="post" class="bg-white p-3 p-md-4 border rounded" style="max-width: 560px;">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">@Localizer["Departamento (rol) a cubrir"]</label>
        <select name="rol" id="rolSelect" class="form-select">
            @foreach (var rol in Enum.GetValues<RolEmpleado>().Where(r => r != RolEmpleado.Admin && r != RolEmpleado.Direccion && r != RolEmpleado.DirectorOrganizacion))
            {
                <option value="@rol">@RolPresentacion.Obtener(rol).Etiqueta</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Empleado que cubre el reemplazo"]</label>
        <select name="empleadoDestinoId" id="empleadoSelect" class="form-select" required>
            <option value="">-- @Localizer["Elegir empleado"] --</option>
            @foreach (var e in empleados)
            {
                var (_, _, etiqueta) = RolPresentacion.Obtener(e.Rol);
                <option value="@e.Id" data-rol="@e.Rol">@e.Nombre (@etiqueta)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Ausente (opcional, solo para contexto)"]</label>
        <input name="ausente" class="form-control" placeholder="@Localizer["Nombre de quien está ausente"]" />
    </div>

    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <label class="form-label">@Localizer["Inicio"]</label>
            <input type="datetime-local" name="fechaInicio" class="form-control" required />
        </div>
        <div class="col-12 col-md-6 mb-3">
            <label class="form-label">@Localizer["Fin"]</label>
            <input type="datetime-local" name="fechaFin" class="form-control" required />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Motivo"]</label>
        <input name="motivo" class="form-control" placeholder="@Localizer["Ej. Baja médica, ausencia imprevista..."]" required />
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-primary">@Localizer["Asignar reemplazo"]</button>
        <a href="/Turnos/Reemplazos" class="btn btn-outline-secondary">@Localizer["Cancelar"]</a>
    </div>
</form>

@section Scripts {
    <script>
        const rolSelect = document.getElementById('rolSelect');
        const empleadoSelect = document.getElementById('empleadoSelect');

        function filtrarEmpleadosPorRol() {
            Array.from(empleadoSelect.options).forEach(opt => {
                if (!opt.dataset.rol) return;
                const visible = opt.dataset.rol === rolSelect.value;
                opt.hidden = !visible;
            });
            if (empleadoSelect.selectedOptions[0]?.hidden) {
                empleadoSelect.value = '';
            }
        }

        rolSelect.addEventListener('change', filtrarEmpleadosPorRol);
        filtrarEmpleadosPorRol();
    </script>
}
